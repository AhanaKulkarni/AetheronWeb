# Public Site & External Links
NEXT_PUBLIC_SITE_URL=https://aetheron.ai
# Replace with the live AetherBuilt domain (e.g. https://aetherbuilt.com) when ready
NEXT_PUBLIC_AETHERBUILT_URL=AETHERBUILT_WEBSITE_URL

# Official Company Contact Details (leave unset to display placeholders)
# NEXT_PUBLIC_REGISTERED_OFFICE=
# NEXT_PUBLIC_COMPANY_EMAIL=
# NEXT_PUBLIC_COMPANY_PHONE=

# -----------------------------------------------------------------------------
# Inquiry Form Delivery (Configure at least ONE transport before launch)
# Never expose these server-side credentials with NEXT_PUBLIC_
# -----------------------------------------------------------------------------

# Option 1: Resend (Recommended)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_FROM_EMAIL=Aetheron Website <noreply@yourdomain.com>
# CONTACT_TO_EMAIL=contact@yourdomain.com

# Option 2: Standard SMTP (via Nodemailer)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# CONTACT_FROM_EMAIL=noreply@yourdomain.com
# CONTACT_TO_EMAIL=contact@yourdomain.com

# Option 3: Custom Webhook (Slack, CRM, Make, Zapier, internal API)
# CONTACT_WEBHOOK_URL=https://hooks.example.com/services/...
